# Bloqueia acesso direto a arquivos sensíveis
<FilesMatch "\.(ino|sql|zip|log|ini|bak|old)$">
    Require all denied
</FilesMatch>

# Bloqueia config.php de leitura direta (inclusive backups tipo config.php.bak)
<Files "config.php">
    Require all denied
</Files>

# Bloqueia visualizacao de diretorios
Options -Indexes

# Otimização de entrega de firmwares para o ESP32 (evita falhas de TLS e buffering)
<FilesMatch "\.bin$">
    SetEnv no-gzip 1
    <IfModule mod_headers.c>
        Header set Connection "close"
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Content-Type "application/octet-stream"
    </IfModule>
</FilesMatch>

# Roteamento direto de firmware OTA para dl_fw.php (evita renegotiation TLS do Apache e registra logs)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^build/.+\.bin$ dl_fw.php [L,QSA]
</IfModule>

# Prioridade de index
DirectoryIndex index.php index.html

# Compressão GZIP para texto, HTML, JS, CSS e JSON (reduz tráfego em ~70%)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml
</IfModule>

# Cache de navegador para arquivos estáticos com versão
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
